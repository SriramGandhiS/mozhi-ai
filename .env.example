# ==========================================
# Lingua AI - Environment Configuration
# ==========================================

# Application
APP_NAME=Lingua AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-secure-random-string-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./lingua_ai.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/lingua_ai

# Primary AI Provider (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Secondary / Fallback AI Providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
INDICTRANS2_API_URL=

# OCR & Speech Configuration
OCR_PROVIDER=gemini
SPEECH_PROVIDER=gemini
TTS_PROVIDER=browser

# File Storage
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./tmp_uploads
MAX_UPLOAD_SIZE_MB=50
TEMP_FILE_TTL_MINUTES=30
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Firebase Authentication (Optional for Guest mode)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# Frontend Environment Variables (place in frontend/.env)
VITE_APP_NAME=Lingua AI
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/api/v1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
